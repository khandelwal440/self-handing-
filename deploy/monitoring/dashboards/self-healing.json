{
  "title": "Self-Healing Control Room",
  "uid": "self-healing",
  "tags": ["self-healing", "chaos"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "Healer actions",
        "enable": true,
        "iconColor": "green",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (action) (changes(healer_remediations_total{result=\"success\"}[1m])) > 0",
        "step": "30s",
        "titleFormat": "Healer: {{action}}"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Availability (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=\"shop\", code!~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"shop\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Auto-remediations (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(healer_remediations_total{result=\"success\"}[1h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "MTTR p50 (6h)",
      "description": "Time from alert start to resolution, for alerts the healer acted on.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(healer_recovery_seconds_bucket[6h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Healer circuit breaker",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(healer_circuit_open)" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED", "color": "green" },
                "1": { "text": "OPEN: needs a human", "color": "red" }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "timeseries",
      "title": "Chaos in: remediable alerts firing",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (alertname) (ALERTS{alertstate=\"firing\", remediation!=\"\"})",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 30, "lineInterpolation": "stepAfter" } }
      }
    },
    {
      "type": "timeseries",
      "title": "Recovery out: healer actions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action, result) (increase(healer_remediations_total[1m])) > 0",
          "legendFormat": "{{action}} · {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80 } }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(http_requests_total{namespace=\"shop\"}[1m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.25 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "shop-api pods: ready vs desired",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=\"shop\", condition=\"true\", pod=~\"shop-api-.*\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"shop\", deployment=\"shop-api\"})",
          "legendFormat": "desired"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "lineInterpolation": "stepAfter" } } }
    },
    {
      "type": "timeseries",
      "title": "Running version (pods)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (version) (app_info{namespace=\"shop\"})",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "lineInterpolation": "stepAfter" } }
      }
    },
    {
      "type": "timeseries",
      "title": "Container restarts (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"shop\"}[5m])) > 0",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Nodes ready",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "legendFormat": "ready"
        },
        { "refId": "B", "expr": "count(kube_node_info)", "legendFormat": "total" },
        { "refId": "C", "expr": "sum(kube_node_spec_unschedulable)", "legendFormat": "cordoned" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "lineInterpolation": "stepAfter" } } }
    }
  ]
}
